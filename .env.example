# Copy to .env and fill in your key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — defaults to claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Todoist integration (for the "Send to Todoist" button on the Shopping tab).
# Get a token at https://app.todoist.com/app/settings/integrations/developer
# TODOIST_API_TOKEN=

# Optional — Todoist project the weekly section is added to. Defaults to "Groceries".
# Created automatically on first push if it doesn't exist yet.
# TODOIST_PROJECT_NAME=Groceries
